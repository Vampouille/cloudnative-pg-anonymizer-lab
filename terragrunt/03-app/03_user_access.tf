locals {
  # One map per CSV line: { url = "user1.campto.camp", user = "user1", password = "..." }
  users_csv = csvdecode(file("${local.variables.users_csv}"))

  # Values shared by all users, merged into each /data JSON
  users_common_data = try(local.variables.users_common_data, {})

  # Internal representation used by DNS, dashboard, Helm chart and cards
  users = [for row in local.users_csv : {
    user     = row.user
    password = row.password
    host     = row.url
  }]

  # Duplicate usernames in the CSV make this expression fail
  users_csv_by_name = { for row in local.users_csv : row.user => row }
}

resource "kubernetes_namespace" "user" {
  for_each = { for u in local.users : u.user => u }

  metadata {
    annotations = {
    "scheduler.alpha.kubernetes.io/node-selector" = "k8s.scaleway.com/project-env=worker"
    }

    labels = {
      "pod-security.kubernetes.io/enforce" = "baseline"
      "pod-security.kubernetes.io/warn" = "baseline"
    }

    name = each.key
  }
}

resource "kubernetes_service_account" "user" {
  for_each = { for u in local.users : u.user => u }

  metadata {
    name = each.key
    namespace = kubernetes_namespace.user[each.key].metadata[0].name
  }
}

resource "kubernetes_token_request_v1" "user" {
  for_each = { for u in local.users : u.user => u }

  metadata {
    name      = kubernetes_service_account.user[each.key].metadata[0].name
    namespace = kubernetes_service_account.user[each.key].metadata[0].namespace
  }
  spec {
    expiration_seconds = 604800 # 7 days
  }
}




output "users_passwords" {
  value = { for u in local.users : u.user => u.password }
  sensitive = true
}

resource "kubernetes_namespace" "users" {

  metadata {
    annotations = {
    "scheduler.alpha.kubernetes.io/node-selector" = "k8s.scaleway.com/project-env=infra"
    }


    name = "users"
  }
}

resource "kubernetes_secret" "user" {
  for_each = { for u in local.users : u.user => u }

  metadata {
    name      = each.key
    namespace = kubernetes_namespace.users.metadata[0].name
  }

  data = {
    token    = kubernetes_token_request_v1.user[each.key].token
    password = each.value.password
    # Served on https://<url>/data and injected in instructions.html:
    # each key "foo_bar" replaces the placeholder __FOO_BAR__ in the page.
    # Common values < CSV line < token
    "data.json" = jsonencode(merge(
      local.users_common_data,
      local.users_csv_by_name[each.key],
      { token = kubernetes_token_request_v1.user[each.key].token }
    ))
    "kubeconfig.yaml" = <<-EOT
apiVersion: v1
kind: Config
clusters:
- name: ${local.variables.name}
  cluster:
    certificate-authority-data: ${var.kubeconfig.cluster_ca_certificate}
    server: ${var.kubeconfig.host}
contexts:
- name: ${each.key}@${local.variables.name}
  context:
    cluster: ${local.variables.name}
    namespace: ${each.key}
    user: ${each.key}
current-context: ${each.key}@${local.variables.name}
users:
- name: ${each.key}
  user:
    token: ${kubernetes_token_request_v1.user[each.key].token}
EOT
  }
}

resource "helm_release" "this" {
  name       = "users"
  chart      = "./charts/users"

  namespace = kubernetes_namespace.users.metadata[0].name
  #disable_webhooks  = true
  #disable_crd_hooks = true
  #skip_crds         = true
  dependency_update  = true
  create_namespace   = false
  #timeout           = 10800
  atomic             = true
  upgrade_install    = true
  force_update       = true

  # users secrets are generated by another script so
  # pod cannot start on initial deployment
  wait = false

  values = [yamlencode({
    users = local.users
    ingress = {
      enabled = true
    }
    # Force redeployment when local chart files change.
    # values-test.yaml is excluded: it is written by local_file.users_values
    # during apply, which would change the checksum between plan and apply.
    chartChecksum = sha1(join("", [
      for f in sort(fileset("./charts/users", "**")) :
      filesha1("./charts/users/${f}") if f != "values-test.yaml"
    ]))
  })]

  depends_on = [ kubernetes_secret.user ]

}

resource "local_file" "users_values" {
  filename = "./charts/users/values-test.yaml"
  content = yamlencode({
    users = local.users
    ingress = {
      enabled = true
    }
  })
}

#TODO: middleware rate limit for token resolution

data "http" "pagedjs" {
  url = "https://unpkg.com/pagedjs/dist/paged.polyfill.js"
}

resource "local_file" "access_cards" {
  filename = "cards.html"
  content = templatefile("cards.html.tpl", {
    users  = local.users
    domain = local.variables.workshop_domain
    css    = file("styles.css")
    pagedjs = data.http.pagedjs.response_body
  })
}
